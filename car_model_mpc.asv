clear; clc; close all;

%% Vehicle parameters
m = 1500;       % mass [kg]
Iz = 3000;      % yaw inertia [kg m^2]
lf = 1.2;       % distance from CG to front axle [m]
lr = 1.6;       % distance from CG to rear axle [m]
Caf = 80000;    % front cornering stiffness [N/rad]
Car = 80000;    % rear cornering stiffness [N/rad]
Vx = 10;        % constant forward speed [m/s]
dt = 0.01;      % time step [s]
T = 30;         % total simulation time [s]
N = T / dt;     % number of time steps
t = 0:dt:(T - dt); % time vector

%% Continuous-time state-space model (error states)
A = [0, 1, 0, 0;
     0, (-2*Caf*lf + 2*Car*lr)/(m*Vx), (2*Caf + 2*Car)/m, (-2*Caf*lf^2 + 2*Car*lr^2)/(m*Vx);
     0, 0, 0, 1;
     0, (2*Caf*lf - 2*Car*lr)/(Iz*Vx), (2*Caf*lf - 2*Car*lr)/Iz, (2*Caf*lf^2 + 2*Car*lr^2)/(Iz*Vx)];

B_delta = [0;
           2*Caf/m;
           0;
           2*Caf*lf/Iz];

B_psi_des = [0;
            (-2*Caf*lf + 2*Car*lr)/(m*Vx);
             0;
            (-2*Caf*lf^2 + 2*Car*lr^2)/(Iz*Vx)];

%% Generate reference trajectory: road with right turn
turn_radius = 30;       % radius of right turn [m]
segment_length = N / 3;

ref_x = zeros(1, N);
ref_y = zeros(1, N);
ref_yaw = zeros(1, N);
ref_psi_dot = zeros(1, N);

% Segment 1: straight
for i = 1:segment_length
    ref_x(i) = Vx * dt * i;
    ref_y(i) = 0;
    ref_yaw(i) = 0;
end

% Segment 2: quarter-circle arc (right turn)
for i = 1:segment_length
    theta = (i / segment_length) * (pi/2);  % 0 to 90 degrees
    ref_x(segment_length + i) = ref_x(segment_length) + turn_radius * sin(theta);
    ref_y(segment_length + i) = ref_y(segment_length) - turn_radius * (1 - cos(theta));
    ref_yaw(segment_length + i) = -theta;  % turning right: negative yaw
end

% Segment 3: straight after turn
for i = 1:segment_length
    idx = 2*segment_length + i;
    ref_x(idx) = ref_x(2*segment_length) + Vx * dt * i * cos(-pi/2);
    ref_y(idx) = ref_y(2*segment_length) + Vx * dt * i * sin(-pi/2);
    ref_yaw(idx) = -pi/2;  % constant heading after turn
end

% Calculate yaw rate (psi_dot)
ref_psi_dot = [diff(ref_yaw)/dt, 0];


%% Discretize system for MPC
sys_c = ss(A, B_delta, eye(4), zeros(4,1));
sys_d = c2d(sys_c, dt);
Ad = sys_d.A;
Bd = sys_d.B;

%% Create MPC controller
mpc_horizon = 15;
mpc_ctrl = mpc(sys_d, dt, mpc_horizon, mpc_horizon);

% Constraints
mpc_ctrl.MV.Min = -0.5; % steering limits [rad]
mpc_ctrl.MV.Max = 0.5;

% Weights
mpc_ctrl.Weights.MV = 0.1;
mpc_ctrl.Weights.MVRate = 0.1;
mpc_ctrl.Weights.OV = [1 0.1 1 0.1];

%% Initialize controller state
x = [0.0; 0; 0; 0];           % initial error state
X = zeros(4, N);              % log state history
X(:,1) = x;
delta = zeros(1, N);          % control input
veh_X = zeros(1, N);          % global X
veh_Y = zeros(1, N);          % global Y
veh_yaw = zeros(1, N);        % global heading
veh_X(1) = ref_x(1);
veh_Y(1) = ref_y(1);
veh_yaw(1) = ref_yaw(1);

% Create MPC controller state
x_mpc = mpcstate(mpc_ctrl);

%% Simulation loop
for k = 1:N-1
    psi_dot_des = ref_psi_dot(k);

    % Measured disturbance (optional): adjust model here if needed

    % Run MPC to compute optimal steering angle
    yref = [0; 0; 0; 0];  % desired error = zero
    u = mpcmove(mpc_ctrl, x_mpc, x, yref);
    delta(k) = u;

    % Simulate system forward
    x = Ad * x + Bd * u + dt * B_psi_des * psi_dot_des;
    X(:,k+1) = x;

    % Global position update
    yaw = ref_yaw(k) - x(3);
    veh_yaw(k+1) = yaw;
    veh_X(k+1) = veh_X(k) + Vx * cos(yaw) * dt;
    veh_Y(k+1) = veh_Y(k) + Vx * sin(yaw) * dt;
end


%% Plot paths
figure;
plot(ref_x, ref_y, 'r--', 'LineWidth', 2); hold on;
plot(veh_X, veh_Y, 'b', 'LineWidth', 2);
xlabel('X [m]'); ylabel('Y [m]');
legend('Reference Path (Figure-8)', 'Vehicle Path');
title('MPC-Controlled Vehicle Path Tracking');
x
axis equal; grid on;

%% Plot tracking performance
figure;
subplot(3,1,1);
plot(t, X(1,:), 'LineWidth', 1.5);
ylabel('Lateral Error e₁ [m]'); grid on;

subplot(3,1,2);
plot(t, rad2deg(X(3,:)), 'LineWidth', 1.5);
ylabel('Heading Error e₂ [deg]'); grid on;

subplot(3,1,3);
plot(t, rad2deg(delta), 'LineWidth', 1.5);
ylabel('Steering \delta [deg]'); xlabel('Time [s]'); grid on;
